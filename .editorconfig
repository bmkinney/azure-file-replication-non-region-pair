root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{bicep,bicepparam,tf,tfvars,hcl,tftest.hcl,json,yml,yaml}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false

# Files copied into the Linux container image must keep LF line endings; see .gitattributes.
[{*.sh,Dockerfile}]
end_of_line = lf
